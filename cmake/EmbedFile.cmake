function(byteforge_embed_file target file function)
    file(READ "${file}" content HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${content}")

    set(output "${CMAKE_CURRENT_BINARY_DIR}/embedded/${function}.cpp")

    file(CONFIGURE OUTPUT "${output}" @ONLY CONTENT [=[
// Generated by byteforge_embed_file from @file@, do not edit
#include <cstddef>
#include <span>

namespace ByteForge::Embedded
{
    namespace
    {
        constexpr unsigned char Data[] = { @bytes@ };
    }

    std::span<const std::byte> @function@() { return std::as_bytes(std::span(Data)); }
}
]=])

    target_sources(${target} PRIVATE "${output}")

    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
endfunction()
